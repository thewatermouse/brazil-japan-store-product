NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_ID=your_paypal_rest_client_id
PAYPAL_CLIENT_SECRET=your_paypal_rest_client_secret
PAYPAL_ENV=sandbox
STATIC_EXPORT=0

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable
# analytics entirely (scripts and events no-op when unset).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Newsletter / waitlist signup (footer). Set the form-action URL from any
# email provider (Buttondown, Mailchimp, ConvertKit, Formspree...). Leave
# empty to show a "coming soon" note instead of a form. If the provider's
# email field is not named "email", set NEXT_PUBLIC_NEWSLETTER_EMAIL_FIELD.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
NEXT_PUBLIC_NEWSLETTER_EMAIL_FIELD=email
